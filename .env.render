# ========================================
# RENDER ENVIRONMENT VARIABLES
# ========================================
# Copy these to Render Dashboard > Environment Variables
# Instructions: https://dashboard.render.com

# ========================================
# DATABASE (REQUIRED)
# ========================================
DB_TYPE=postgresql
DB_HOST=aws-0-ap-southeast-1.pooler.supabase.com
DB_PORT=5432
DB_NAME=postgres
DB_USER=postgres.qthrznudzkgzrwvygmbd
DB_PASSWORD=Elis2026#123

# ========================================
# FLASK (REQUIRED)
# ========================================
FLASK_ENV=production

# Generate SECRET_KEY: python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=REPLACE_WITH_64_CHARACTER_RANDOM_STRING

# ========================================
# EMAIL - GMAIL SMTP (REQUIRED FOR OTP)
# ========================================
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=1
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-16-char-gmail-app-password
MAIL_DEFAULT_SENDER=STMS <no-reply@elis.local>

# ========================================
# GOOGLE OAUTH (OPTIONAL)
# ========================================
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret

# ========================================
# APPLICATION SETTINGS
# ========================================
UPLOAD_FOLDER=app/static/uploads
MAX_CONTENT_LENGTH_MB=10
RESERVATION_AUTO_CANCEL_HOURS=48

# ========================================
# NOTES:
# ========================================
# 1. DO NOT include quotes around values in Render
# 2. Generate SECRET_KEY using the command above
# 3. Use Gmail App Password, not your regular Gmail password
# 4. Update Google OAuth redirect URIs after deployment:
#    - https://your-app.onrender.com/auth/google/callback
# 5. Save this file locally - DO NOT commit to Git
