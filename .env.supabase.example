FLASK_ENV=production
SECRET_KEY=your-super-secret-key-here-change-this-to-random-string

# Supabase PostgreSQL Configuration
DB_TYPE=postgresql
DB_HOST=db.xxxxx.supabase.co
DB_PORT=5432
DB_NAME=postgres
DB_USER=postgres
DB_PASSWORD=your-supabase-database-password-here

# Uploads
UPLOAD_FOLDER=app/static/uploads
MAX_CONTENT_LENGTH_MB=10

# Email Configuration (optional)
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=1
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-app-password
MAIL_DEFAULT_SENDER="ELIS System <no-reply@elis.com>"

# Reservation auto-cancel hours
RESERVATION_AUTO_CANCEL_HOURS=48

# Google OAuth (optional)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=https://your-domain.com/auth/google/callback
